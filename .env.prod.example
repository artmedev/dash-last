# Production settings, kept in .env.prod (not committed). Deployed by rostok (D:\dev\rostok, stack "dash"),
# which mounts this file into the stack; both the app and its Postgres read it.
NODE_ENV=production
PORT=3001
POSTGRES_USER=dash
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dash
DATABASE_URL=postgres://dash:change-me@dash-db:5432/dash
GOOGLE_CLIENT_ID=823950055847-3t7n67vjdlpu2if6jh8tce55k4vhkp89.apps.googleusercontent.com
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Shares the login cookie with other artme.dev sites, which ask Dash /api/auth/check
COOKIE_DOMAIN=.artme.dev
# Comma-separated emails of superadmins: only they may open Tools and Jobs
SUPERADMIN_EMAILS=you@example.com
