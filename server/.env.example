DATABASE_URL=postgres://dash:dash@localhost:5434/dash
PORT=3001
# OAuth 2.0 Client ID (Web application) from Google Cloud Console
GOOGLE_CLIENT_ID=
# Random string for signing sessions
SESSION_SECRET=change-me
# Allow sign-in without Google for local development (never in production)
DEV_AUTH=1
# Comma-separated emails of superadmins: only they may open Tools and Jobs (private sites behind Dash login)
SUPERADMIN_EMAILS=
